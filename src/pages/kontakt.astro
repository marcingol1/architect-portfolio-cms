---
import Base from '../layouts/Base.astro';
---

<Base
  title="Kontakt"
  description="Skontaktuj się z pracownią — pierwsza rozmowa o projekcie jest zawsze niezobowiązująca."
>
  <header class="page-head">
    <div class="reveal">
      <p class="kicker">Kontakt</p>
      <h1 class="page-head__title">
        Najlepsze projekty zaczynały się <em>od jednego maila</em>.
      </h1>
    </div>
  </header>

  <section class="contact">
    <div class="contact__details reveal">
      <div class="contact__block">
        <h2 class="contact__heading">Napisz lub zadzwoń</h2>
        <p class="contact__big">
          <a href="mailto:pracownia@architektgol.pl">pracownia@architektgol.pl</a>
        </p>
        <p class="contact__big">
          <a href="tel:+48221234567">+48 22 123 45 67</a>
        </p>
      </div>
      <div class="contact__block">
        <h2 class="contact__heading">Pracownia</h2>
        <p>
          ul. Wspólna 12/4
          <br />
          00-680 Warszawa
          <br />
          pn–pt, 9:00–17:00 — po umówieniu
        </p>
      </div>
      <div class="contact__block">
        <h2 class="contact__heading">Zanim napiszesz</h2>
        <p>
          Najbardziej pomaga nam kilka zdań o&nbsp;działce (lokalizacja,
          wielkość), o&nbsp;tym, co ma powstać, oraz orientacyjny budżet.
          Odpowiadamy w&nbsp;ciągu dwóch dni roboczych.
        </p>
      </div>
    </div>

    <div class="contact__form-wrap reveal" style="transition-delay: 0.08s">
      <form
        class="contact-form"
        name="kontakt"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="kontakt" />
        <p class="visually-hidden">
          <label>
            Nie wypełniaj tego pola: <input name="bot-field" />
          </label>
        </p>
        <div class="contact-form__field">
          <label for="cf-name">Imię i nazwisko</label>
          <input id="cf-name" name="name" type="text" required />
        </div>
        <div class="contact-form__field">
          <label for="cf-email">Adres e-mail</label>
          <input id="cf-email" name="email" type="email" required />
        </div>
        <div class="contact-form__field">
          <label for="cf-message">Kilka słów o projekcie</label>
          <textarea id="cf-message" name="message" rows="6" required></textarea>
        </div>
        <button type="submit" class="button">Wyślij wiadomość</button>
      </form>
    </div>
  </section>
</Base>
