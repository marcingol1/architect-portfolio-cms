---
import Base from '../layouts/Base.astro';
---

<Base title="404 — nie znaleziono strony">
  <section class="not-found">
    <p class="kicker">Błąd 404</p>
    <h1 class="not-found__title">
      Ta strona nie została <em>zaprojektowana</em>.
    </h1>
    <p class="not-found__text">
      Adres nie istnieje albo został przeniesiony podczas przebudowy.
    </p>
    <div class="not-found__actions">
      <a href="/" class="button">Strona główna</a>
      <a href="/realizacje/" class="arrow-link">Zobacz realizacje</a>
    </div>
  </section>
</Base>
