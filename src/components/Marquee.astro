---
// Typographic band scrolling between sections. Pure CSS animation,
// paused for prefers-reduced-motion; decorative — hidden from screen readers.
const { items } = Astro.props;
const doubled = [...items, ...items];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {
      doubled.map((item) => (
        <span class="marquee__item">
          {item}
          <span class="marquee__dot" />
        </span>
      ))
    }
  </div>
</div>
